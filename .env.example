# ---- Producer -----------------------------------------------------------------
# 1000 events/s = 60,000 events/min
EVENTS_PER_SECOND=1000
NUM_USERS=10000
# Fraction of deliberately malformed events, to exercise the dead-letter topic.
INVALID_EVENT_RATE=0.001
# 0 = run forever
DURATION_SECONDS=0

# ---- Kafka / Schema Registry --------------------------------------------------
EVENTS_TOPIC=user-events
DLQ_TOPIC=user-events-dlq
TOPIC_PARTITIONS=6
SCHEMA_COMPATIBILITY=BACKWARD

# ---- Spark --------------------------------------------------------------------
TRIGGER_INTERVAL=10 seconds
WATERMARK_DELAY=2 minutes
SHUFFLE_PARTITIONS=6
MAX_OFFSETS_PER_TRIGGER=500000
STARTING_OFFSETS=latest

# ---- Redis online store -------------------------------------------------------
FEATURE_PREFIX=eddy
FEATURE_TTL_SECONDS=86400
REDIS_PASSWORD=
